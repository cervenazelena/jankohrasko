# Janko Hraško — cesty a prostredia. Skopíruj na config.env a uprav:
#     cp config.example.env config.env
# Načítavajú ju všetky skripty v perun/ a server/. Spúšťaj ich z koreňa repa,
# alebo nastav JH_CONFIG=/cesta/k/config.env.

# Klon tohto repa (kód) a adresár pre veľké dáta (scratch/project FS — samotný model má ~1,6 TB).
JH_REPO="$HOME/jankohrasko"
JH_DATA="/scratch/$USER/jankohrasko"

# Python env so SGLang (conda env alebo venv). Skripty volajú priamo jeho bin/,
# `conda activate` netreba (na Perune je po migrácii úložiska conda rozbitá).
JH_SGLANG_ENV="$HOME/miniconda3/envs/sglang"

# Model — HF repo sgl-project/DeepSeek-V4-Pro-FP8 (stiahne server/download_model.sh).
JH_MODEL_PATH="$JH_DATA/DeepSeek-V4-Pro-FP8"

# Agentická vrstva.
JH_AGENT_VENV="$JH_DATA/agentic_venv"       # čistý venv s CPU torchom (perun/setup_agentic_env.sh)
JH_RAG_DOCS="$JH_DATA/rag_docs"             # zdrojové texty pre RAG (štruktúra: docs/03_rag_korpus.md)
JH_RAG_INDEX="$JH_DATA/rag_index"           # FAISS + meta.jsonl + manifest.txt
JH_AGENT_OUT="$JH_DATA/agent_out"           # súbory pre používateľov; názov MUSÍ byť agent_out
JH_QUERY_LOG="$JH_DATA/agent_queries.jsonl" # log otázok (osobné údaje — nezverejňovať!)

# Zdrojáky DeepEP (iba pre server/test_deepep_internode.sh).
JH_DEEPEP_SRC="$JH_DATA/DeepEP"

# InfiniBand HCA pre NCCL/NVSHMEM — jeden rail (multi-rail padal: 719 dispatch fault).
JH_IB_HCA="mlx5_0"

# Názov SLURM jobu — podľa neho login uzol hľadá master uzol pre tunel (perun/agent_node.sh).
JH_JOB_NAME="sglang_agentic"
